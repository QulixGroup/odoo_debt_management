<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="debts_management.AccountReportFilterSalesPerson" t-inherit="account_reports.AccountReportFilterExtraOptions" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@class, 'filter_show_all_hook')]" position="after">
            <t>
                <Dropdown
                    menuClass="'account_report_filter salesperson'"
                >
                    <button class="btn btn-secondary">
                        <i class="fa fa-folder-open me-1"/>Salespeople
                    </button>

                    <t t-set-slot="content">
                        <div class="dropdown-item gap-2 align-items-center">
                            <label>Salespeople</label>
                            <MultiRecordSelector t-props="getMultiRecordSelectorProps('res.users', 'salesperson_ids')" domain="[['share', '=', false]]"/>
                        </div>
                    </t>
                </Dropdown>
            </t>
        </xpath>
    </t>
</templates>

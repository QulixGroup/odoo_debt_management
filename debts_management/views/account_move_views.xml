<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="account_view_move_form_inherited" model="ir.ui.view">
            <field name="name">debts.management.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="partner_shipping_id" position="after">
                    <field name="is_disputed" string="Is Disputed"/>
                    <field name="is_in_collection" string="In Collection"/>
                </field>
            </field>
        </record>

        <record id="debts_management_invoice_filter" model="ir.ui.view">
            <field name="name">debts.management.invoice.select</field>
            <field name="model">account.move</field>
            <field
                name="inherit_id"
                ref="account.view_account_invoice_filter"
            />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//filter[@name='to_check']" position="after">
                        <filter
                            name="expected_payments"
                            string="Due this week"
                            domain="[('invoice_date_due', '&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%Y-%m-%d')),
                                    ('invoice_date_due', '&lt;=', ((context_today() + relativedelta(weeks=-1, weekday=0) + relativedelta(days=6))).strftime('%Y-%m-%d'))]"
                            help="Invoices expected to be paid this week"
                        />
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_move_tree_debts_management" model="ir.ui.view">
            <field name="name">account.move.list.debt</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree_multi_edit" />
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <header>
                        <button name="%(action_ar_export_wizard)d"
                                string="Export"
                                type="action"
                                class="btn-primary"
                                display="always"/>
                        <button name="%(account_followup.manual_reminder_action)d"
                                string="Send Reminder"
                                type="action"
                                class="btn-primary"
                                display="always"/>
                    </header>
                </xpath>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                </xpath>
                
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                </xpath>
                
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                </xpath>
                
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                </xpath>

                <xpath expr="//field[@name='ref']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='amount_total_signed']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='activity_ids']" position="after">
                    <field name="invoice_date_due" string="Due Date" optional="show"/>
                    <field name="invoice_overdue_days" optional="show"/>
                    <field name="notification_count" optional="show"/>
                    <field name="total_return_display" optional="show" decoration-bf="1"/>
                    <field name="last_notification_date" string="Last Notification" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="action_move_out_invoice_type_inherited" model="ir.actions.act_window">
            <field name="name">Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,activity</field>
            <field name="view_id" ref="view_move_tree_debts_management" />
            <field name="search_view_id" ref="debts_management_invoice_filter" />
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'search_default_late': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a customer invoice
                </p><p>
                Create invoices, register payments and keep track of the discussions with your customers.
                </p>
            </field>
        </record>
    </data>
</odoo>
